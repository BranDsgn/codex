# Node 24+ standalone server. The server does not read .env automatically.
# Start with: node --env-file=.env server/index.mjs
# Leave password unset only for a local sample-data workspace.
# CURRENT_ADMIN_PASSWORD=use-a-unique-password-at-least-16-characters-long
CURRENT_HOST=127.0.0.1
PORT=4173
# Use a fresh path for the real workspace, separate from local sample records.
CURRENT_DB=data/store.sqlite
# Set true when hosting behind HTTPS. Keep false only for loopback development.
CURRENT_COOKIE_SECURE=false
